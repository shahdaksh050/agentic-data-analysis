# =============================================================
# .env.example — Environment Variable Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER commit .env to source control.
# =============================================================

# --- LLM Provider API Keys (choose one or both) ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- LLM Model Configuration ---
LLM_PROVIDER=openai               # "openai" or "anthropic"
LLM_MODEL=gpt-4o                  # e.g. gpt-4o, claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# --- Agent Configuration ---
MAX_ITERATIONS=15                 # Max reasoning-execution cycles
ENABLE_RLM_INFERENCE=true         # Enable Recursive Language Model patterns
RLM_MAX_DEPTH=5                   # Max recursion depth for sub-tasks
CONFIDENCE_THRESHOLD=0.85

# --- Observability (Optional) ---
PHOENIX_API_KEY=                  # Arize Phoenix for trace visualization
LANGSMITH_API_KEY=                # LangSmith alternative

# --- Output Configuration ---
OUTPUT_DIR=output
REPORTS_DIR=output/reports
VISUALIZATIONS_DIR=output/visualizations
MODELS_DIR=output/models
